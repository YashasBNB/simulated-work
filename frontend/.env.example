# Base URL of the FastAPI backend.
# Leave as /api-relative (empty prefix) to use the Vite dev proxy defined in vite.config.ts.
# For a deployed build, set the absolute backend origin, e.g. https://assistant.internal
VITE_API_BASE_URL=

# Backend origin the Vite dev server proxies /api to. Dev-only.
VITE_DEV_PROXY_TARGET=http://localhost:8000
